# ============================================================
# EcoSignal — Root Environment Variables
# Copy to .env and fill in real values before running.
# Usage: cp .env.example .env
# ============================================================

# === SHARED ===
# JWT signing key (min 32 characters in production)
SECRET_KEY=change-me-in-production-min-32-chars
# JWT algorithm
ALGORITHM=HS256
# Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === DATABASE ===
# Postgres credentials (used by postgres container + services)
POSTGRES_USER=ecosignal
POSTGRES_PASSWORD=ecosignal_dev
POSTGRES_DB=ecosignal
# Async connection string for SQLAlchemy (must match above credentials)
DATABASE_URL=postgresql+asyncpg://ecosignal:ecosignal_dev@postgres:5432/ecosignal

# === REDIS ===
# Redis connection URL (used by env-data, api-gateway)
REDIS_URL=redis://redis:6379/0
# env-data uses a prefixed var name
ENV_DATA_REDIS_URL=redis://redis:6379/0

# === EXTERNAL APIs ===
# Regolo AI API key (used by ai-narrative, model: mistral-small-4-119b)
REGOLO_API_KEY=your-regolo-api-key-here
# OpenAQ API key (used by env-data)
OPENAQ_API_KEY=your-openaq-api-key-here
ENV_DATA_OPENAQ_API_KEY=your-openaq-api-key-here

# === SERVICE CONFIG ===
# Global log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# env-data: cache TTL for environmental data (seconds)
ENV_DATA_CACHE_TTL_SECONDS=3600
# env-data: external API base URLs
ENV_DATA_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
ENV_DATA_OPENAQ_BASE_URL=https://api.openaq.org/v3
# env-data: request timeout for external APIs (seconds)
ENV_DATA_REQUEST_TIMEOUT_SECONDS=10
# env-data: use fallback values on timeout
ENV_DATA_FALLBACK_ON_TIMEOUT=true
