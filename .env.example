# ============================================================
# EcoSignal — Root environment file
# Copy to .env and fill in real values before running
# NEVER commit .env to git
# ============================================================

# === POSTGRES ===
POSTGRES_USER=ecosignal
POSTGRES_PASSWORD=ecosignal_dev_password
POSTGRES_DB=ecosignal

# === SHARED AUTH (read by api-gateway AND user-profile) ===
SECRET_KEY=change-me-to-a-random-32-char-string-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === EXTERNAL APIs ===
# Anthropic — get key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAQ — get free key at https://explore.openaq.org/register
ENV_DATA_OPENAQ_API_KEY=your-openaq-api-key-here

# === LOGGING ===
LOG_LEVEL=INFO
