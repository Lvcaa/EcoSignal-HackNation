# JWT Configuration
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Downstream service URLs
USER_PROFILE_SERVICE_URL=http://user-profile:8001
FOOTPRINT_SERVICE_URL=http://footprint-engine:8002
ENV_DATA_SERVICE_URL=http://env-data:8003
AI_NARRATIVE_SERVICE_URL=http://ai-narrative:8004
ACTIONS_SERVICE_URL=http://actions-engine:8005
COMMUNITY_SERVICE_URL=http://community:8006

# Redis (rate limiting, cache)
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO
